/**
 * Copy to config.local.php and adjust for your server (config.local.php is not committed).
 *
 * Example — site at domain root (public_html):
 *   define('BASE_PATH', '');
 *
 * Example — site in a subfolder:
 *   define('BASE_PATH', '/SmartIStore');
 *
 * Example — database on hosting:
 *   define('DB_HOST', '127.0.0.1');
 *   define('DB_NAME', 'smartistore_db');
 *   define('DB_USER', 'smartistore_user');
 *   define('DB_PASS', 'smartistorepwd');
 *
 * Optional — store uploads outside the Git repo (must exist and be writable):
 *   define('UPLOADS_BASE_PATH', '/var/smaristore/uploads');
 *
 * If assets/uploads is a symlink, the target folder must exist, e.g.:
 *   mkdir -p /var/smaristore/uploads/items
 *   ln -sfn /var/smaristore/uploads /path/to/SmartIStore/assets/uploads
 *
 * If the symlink is broken, either fix the target or remove the link and use a normal folder:
 *   rm assets/uploads
 *   mkdir -p assets/uploads/items
 *   chmod -R 775 assets/uploads
 */

